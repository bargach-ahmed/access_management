<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_access_management" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.access.management</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Access Management" string="Access Management" name="access_management">
                    <block title="Access Management &amp; Security Control" name="access_management_setting_container">
                        <setting id="access_profiles_setting" help="Create and manage userwise &amp; groupwise access profiles.">
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="action_open_access_management"
                                            string="Manage Access Profiles"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-shield"/>
                                </div>
                                <div class="text-muted mt8">
                                    <field name="access_management_count" class="oe_inline font-weight-bold"/> Active Security Profiles configured.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
